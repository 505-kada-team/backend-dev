# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/mern_capstone

# JWT
JWT_ACCESS_SECRET=ganti_dengan_secret_yang_kuat_min_32_karakter
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=ganti_dengan_secret_lain_yang_kuat_min_32_karakter
JWT_REFRESH_EXPIRES=7d
JWT_RESET_SECRET=ganti_dengan_secret_ketiga_yang_kuat_min_32_karakter
JWT_RESET_EXPIRES=10m

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SMTP (Gmail App Password, BUKAN password akun biasa)
# Cara buat: myaccount.google.com/apppasswords (wajib aktifkan 2FA dulu)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=capstonemu@gmail.com
SMTP_PASS=ganti_dengan_16_digit_app_password
SMTP_FROM_NAME=Capstone App

# OTP
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
